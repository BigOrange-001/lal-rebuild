            var fingers:Array=id=="claw" ? [[52,54,78,36,102,40],[60,64,90,64,116,60],[52,74,78,92,102,88]] : [[52,54,76,42,92,58],[60,64,86,62,98,68],[52,74,76,86,92,72]];
