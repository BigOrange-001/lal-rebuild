            g.moveTo(0,16);g.lineTo(116,7);g.curveTo(128,8,128,16);g.curveTo(128,24,116,25);g.lineTo(0,16);g.endFill();
            hfxAPaintDraw106(bmp,shape,2);
         }
         else if(id=="shuriken")
         {
