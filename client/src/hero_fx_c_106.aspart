               g.curveTo(50,14,60,12);g.curveTo(80,10,84,30);g.curveTo(88,54,48,82);
               g.lineStyle(2.5,W,.9);g.moveTo(48,82);g.curveTo(42,88,38,94);g.moveTo(48,82);g.curveTo(55,87,58,93);
