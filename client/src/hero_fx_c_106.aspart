               g.beginGradientFill("radial",[0xF0F6FF,0xA8B4C8,0x5A6478],[1,1,1],[0,150,255],m,"pad","rgb",-.3);
               g.drawCircle(48,52,38);g.endFill();
               g.lineStyle(1,0x3A4050,.7);
