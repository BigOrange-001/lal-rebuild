      // Aurelion Sol's chain lightning, every star: no range limit and it crosses lanes.
      // The first bolt takes the nearest enemy in his lane (the nearest lane when his is
      // empty); each jump takes the unhit enemy nearest the last one, same lane first.
      // Mirrored by SixStarNextBattle.aoxing_chain_targets (server/six_star_next_battle_105.py).
      private static const AOXING_CHAIN_MAX106:int = 5;
      private static const AOXING_CHAIN_SOLO106:Number = 3;
      private static const AOXING_CHAIN_STEP106:Number = .12;

      private function aoxingChainNext106(from:Avatar, visited:Array) : Avatar
      {
         var lane:int=from ? from.line : line;var at:Number=from ? from.pos : pos;
         var best:Avatar=null;var bestLane:int=0;var bestGap:Number=0;
         for each(var foe:Avatar in abilityAllEnemies())
         {
            if(visited.indexOf(foe)>=0) continue;
            var laneGap:int=Math.abs(foe.line-lane);var gap:Number=Math.abs(foe.pos-at);
            if(!best || laneGap<bestLane || laneGap==bestLane && (gap<bestGap || gap==bestGap && foe.abilityIndex<best.abilityIndex))
            {
               best=foe;bestLane=laneGap;bestGap=gap;
            }
         }
         return best;
      }

      private function aoxingChainTargets106() : Array
      {
         var targets:Array=[];
         var foe:Avatar=aoxingChainNext106(null,targets);
         while(foe && targets.length<AOXING_CHAIN_MAX106)
         {
            targets.push(foe);
            foe=aoxingChainNext106(foe,targets);
         }
         return targets;
      }

      // One chain of up to five bolts; a lone enemy takes three times the first bolt.
      // Returns true when a bolt landed on an enemy hero (the 4/5-star charge rule).
      private function aoxingChain106(first:Number, bounce:Number, kind:int, effect:String, manual:Boolean) : Boolean
      {
         var targets:Array=aoxingChainTargets106();
         var hero:Boolean=false;
         var from:Avatar=this;
         var batch:Object=targets.length>1 ? beginParallelVisualBatch() : null;
         try
         {
            for(var i:int=0;i<targets.length;i++)
            {
               var target:Avatar=targets[i];
               var ratio:Number=i>0 ? bounce : first*(targets.length==1 ? AOXING_CHAIN_SOLO106 : 1);
               if(batch) setParallelVisualWave(batch,i,AOXING_CHAIN_STEP106);
               heroFxClaim106("chain","1114",target,{from:from,hop:i,solo:targets.length==1});
               if(manual)
               {
                  if(abilityHit(target,ratio,kind,effect,0,from) && target.getType()==1 && !target.isManualSummonUnit) hero=true;
               }
               else sixStarHit105(target,ratio,kind,effect);
               from=target;
            }
         }
         finally
         {
            if(batch) endParallelVisualBatch(batch);
         }
         return hero;
      }

