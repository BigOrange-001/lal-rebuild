      public function updateBondSkills104() : void
      {
         if(!GlobalData.$mConfig_simple.bonds_104 || !avatarData || mData && mData.hp_max) return;
         var keys:Array = [];
         for each(var bond:Object in getBondRows104())
            if(!bond.runtime_only) keys.push(String(bond.id));
         keys.sort();
         var all:Object = GlobalData.$mConfig_simple.bond_skill_variants_104;
         var variants:Object = all ? all[avatarData.id] : null;
         var variant:Object = variants ? variants[keys.join("|")] : null;
         var sourceTable:Object = GlobalData.$mConfig_simple.bond_skill_sources_104;
         var sources:Object = sourceTable ? sourceTable[avatarData.id] : null;
         var normal:String = variant && variant.skill && sources && sources.skill == avatarData.skill0 ? String(variant.skill) : avatarData.skill0;
         var captain:String = variant && variant.leader_skill && sources && sources.leader_skill == avatarData.skill1 ? String(variant.leader_skill) : avatarData.skill1;
         normal = equipmentSkillId104(normal);
         captain = equipmentSkillId104(captain);
         var heroRow104:Object = GlobalData.$mConfig_avatar[avatarData.id];
         var passive104:String = heroRow104 && heroRow104.pl.length>13 ? heroRow104.pl[13] : null;
         if(variant && variant.skillB && sources && sources.skillB == passive104) passive104 = String(variant.skillB);
         passive104 = equipmentSkillId104(passive104);
         if(passive104 && (!skillB || skillB.skillSetData.id != passive104)) skillB = new SkillSet(passive104,this,1);
         if(normal && (!skill0 || skill0.skillSetData.id != normal || skill0.lv != slv)) skill0 = new SkillSet(normal,this,slv);
         if(captain && (!skill1 || skill1.skillSetData.id != captain)) skill1 = new SkillSet(captain,this,1,true);
      }

      public function getBondEntries104() : Array
      {
         var entries:Array = [];
         if(!avatarData) return entries;
         var definitions:Array = GlobalData.$mConfig_simple.bonds_104 as Array;
         var family:String = String(avatarData.id).split("_").slice(0,2).join("_");
         var active:Array = getBondRows104();
         var labels:Object = {hp:"生命",ap:"攻击",de_ph:"物防",de_ma:"法防",hit:"精准",flee:"闪避",crit:"暴击",tough:"韧性"};
         for each(var bond:Object in definitions)
         {
            if(bond.families.indexOf(family)<0) continue;
            var names:Array = [];
            var body:String = "";
            for each(var member:String in bond.families)
            {
               var quality:int = Math.max(getStar(),int(bond.minimum_quality[member]));
               var hero:Object = GlobalData.$mConfig_avatar[member+"_"+quality];
               if(!hero) hero = GlobalData.$mConfig_avatar[member+"_"+bond.minimum_quality[member]];
               var name:String = hero ? hero.name : member;
               names.push(name);
               if(member != family) continue;
               var benefit:Object = bond.benefits[member];
               var effects:Array = [];
               if(benefit.stats) for(var stat:String in benefit.stats) effects.push(labels[stat]+"提高"+Math.round(Number(benefit.stats[stat])*10000)/100+"%");
               var flats:Object = benefit.flat_by_quality ? benefit.flat_by_quality[String(quality)] : null;
               if(flats) for(stat in flats) effects.push(labels[stat]+"增加"+flats[stat]);
               if(benefit.skill_rate) effects.push((benefit.passive_skill_rate ? "小技能和大招数值提高" : "技能数值提高")+Math.round(Number(benefit.skill_rate)*100)+"%");
               if(benefit.passive_skill_rate && hero && hero.pl.length>13 && hero.pl[13]) effects.push("被动数值提高"+Math.round(Number(benefit.passive_skill_rate)*100)+"%");
               if(benefit.info) effects.push(String(benefit.info));
               if(bond.focus==member)
               {
                  var variantTable:Object = GlobalData.$mConfig_simple.bond_skill_variants_104;
                  var memberVariants:Object = hero && variantTable ? variantTable[hero.id] : null;
                  var binding:Object = memberVariants ? memberVariants[String(bond.id)] : null;
                  var normalInfo:String = SkillSet.conciseInfo104(bond.mechanism.normal.info);
                  var captainInfo:String = bond.mechanism.captain ? SkillSet.conciseInfo104(bond.mechanism.captain.info) : "";
                  if(binding && binding.skill) normalInfo = new SkillSet(String(binding.skill),this,1).getInfo();
                  if(binding && binding.leader_skill) captainInfo = new SkillSet(String(binding.leader_skill),this,1,true).getInfo();
                  effects.push(bond.mechanism.normal.name+"："+normalInfo);
                  if(bond.mechanism.captain) effects.push(bond.mechanism.captain.name+"："+captainInfo);
               }
               body += "\n\n"+effects.join("；\n");
            }
            var enabled:Boolean = active.indexOf(bond)>=0;
            var info:String = "组合："+names.join("、")+body;
            entries.push({txt:String(bond.name),isOK:enabled,info:info});
         }
         var all:Object = GlobalData.$mConfig_simple.equipment_bonds_104;
         var equipmentRows:Array = all ? all[avatarData.id] as Array : null;
         var equipped:Array = getEquipmentBondRows104();
         for each(var row:Object in equipmentRows)
         {
            var equipment:Object = GlobalData.$mConfig_equip[row.equipment];
            enabled = equipped.indexOf(row)>=0;
            info = (enabled ? "已激活" : "未激活")+"\n本人装备"+(equipment ? equipment.name : row.equipment)+"\n"+SkillSet.conciseInfo104(row.info);
            if(row.kind=="ordinary" && row.reworks) for(var rewriteName:String in row.reworks) info += "\n\n"+rewriteName+"："+SkillSet.conciseInfo104(row.reworks[rewriteName].info);
            entries.push({txt:equipment ? String(equipment.name) : String(row.equipment),isOK:enabled,info:info});
         }
         return entries;
      }

      public function getBondDescription104() : String
      {
         var definitions:Array = GlobalData.$mConfig_simple.bonds_104 as Array;
         if(!definitions) return "";
         var family:String = String(avatarData.id).split("_").slice(0,2).join("_");
         var active:Array = getBondRows104();
         var text:String = "";
         var labels:Object = {hp:"生命",ap:"攻击",de_ph:"物防",de_ma:"法防",hit:"精准",flee:"闪避",crit:"暴击",tough:"韧性"};
         for each(var bond:Object in definitions)
         {
            if(bond.families.indexOf(family)<0) continue;
            var names:Array = [];
            for each(var member:String in bond.families)
            {
               var hero:Object = GlobalData.$mConfig_avatar[member+"_"+bond.minimum_quality[member]];
               names.push(hero ? hero.name : member);
            }
            var description:String = bond.name+"（"+(active.indexOf(bond)>=0 ? "已激活" : "未激活")+"）\n"+names.join("、");
            var benefit:Object = bond.benefits[family];
            if(benefit.stats) for(var stat:String in benefit.stats) description += "\n"+labels[stat]+" +"+Math.round(Number(benefit.stats[stat])*10000)/100+"%（独立乘区）";
            var flats:Object = benefit.flat_by_quality ? benefit.flat_by_quality[String(getStar())] : null;
            if(flats) for(stat in flats) description += "\n"+labels[stat]+" +"+flats[stat];
            if(benefit.skill_rate) description += "\n技能数值 +"+Math.round(Number(benefit.skill_rate)*100)+"%";
            if(benefit.info) description += "\n"+String(benefit.info);
            if(bond.focus==family) description += "\n"+bond.mechanism.normal.name+"："+bond.mechanism.normal.info+(bond.mechanism.captain ? "\n"+bond.mechanism.captain.name+"："+bond.mechanism.captain.info : "");
            if(bond.focus==family && GlobalData.$mConfig_simple.hero_skill_output_rate_104 != null) description += "\n伤害、护盾、治疗按上述技能基准的80%结算；增减益不变。";
            text += "<br/>"+Tools.formatHtmlText(description.replace(/\n/g,"<br/>"),active.indexOf(bond)>=0 ? 0x00CCFF : 0x888888,false,15,"",0);
         }
         return text;
      }

      private static var purpleBondMap:GameMap;

      private static function ensurePurpleBonds() : void
      {
         var map:GameMap = GameMap.currentMap;
         if(!map || purpleBondMap === map) return;
         purpleBondMap = map;
         var definitions:Array = GlobalData.$mConfig_simple.purple_bonds as Array;
         if(!definitions) return;
         for(var side:int=1;side<=2;side++)
         {
            var units:Vector.<Avatar> = side == 1 ? map.team1List : map.team2List;
            if(!units) continue;
            for each(var original:Avatar in units) if(original && original.abilityState) delete original.abilityState.bond;
            for each(var bond:Object in definitions)
            {
               if(!(bond.families is Array) || bond.families.length == 0) continue;
               var families:Array = [];
               var members:Array = [];
               for each(var unit:Avatar in units)
               {
                  if(!unit || unit.getStar()!=5 || unit.getType()!=1 || unit.isManualSummonUnit || !GlobalData.modChannelAllowed(unit.avatarData.id,"usage.destiny")) continue;
                  var family:String = GlobalData.baseModHeroId(unit.avatarData.id).split("_").slice(0,2).join("_");
                  if(bond.families.indexOf(family)<0 || families.indexOf(family)>=0) continue;
                  members.push(unit);
                  families.push(family);
               }
               if(families.length==bond.families.length) for each(unit in members) unit.abilityState.bond=String(bond.id);
            }
         }
      }

      public function getPurpleBondIsActive() : Boolean
      {
         if(GlobalData.$mConfig_simple.bonds_104) return getBondRows104().length>0;
         if(!GlobalData.modChannelAllowed(avatarData.id,"usage.destiny") || getStar()!=5 || getType()!=1 || !GlobalData.$userData || !GlobalData.$userData.team || !GlobalData.$userData.avatars) return false;
         var definitions:Array = GlobalData.$mConfig_simple.purple_bonds as Array;
         if(!definitions) return false;
         var family:String = GlobalData.baseModHeroId(avatarData.id).split("_").slice(0,2).join("_");
         var teamIndex:int = GlobalData.$userData.attrs && GlobalData.$userData.attrs.team_num != null ? int(GlobalData.$userData.attrs.team_num) : 0;
         var teams:Array = GlobalData.$userData.team as Array;
         var lineup:Array = teams && teamIndex >= 0 && teamIndex < teams.length ? teams[teamIndex] as Array : null;
         if(!lineup) return false;
         for each(var bond:Object in definitions)
         {
            if(!(bond.families is Array) || bond.families.indexOf(family)<0) continue;
            var found:Array = [];
            var selfInLineup:Boolean = false;
            for each(var instanceId:Object in lineup)
            {
               var instance:String = String(instanceId);
               var hero:Object = GlobalData.$userData.avatars[instance];
               if(!hero) continue;
               var aid:String = String(hero.aid != null ? hero.aid : instance).split("|")[0];
               var parts:Array = aid.split("_");
               if(parts.length != 3 || parts[0] != "A" || parts[1].charAt(0) != "1" || int(parts[2]) != 5) continue;
               if(instance == id) selfInLineup = true;
               var memberFamily:String = parts[0] + "_" + parts[1];
               if(bond.families.indexOf(memberFamily)>=0 && found.indexOf(memberFamily)<0) found.push(memberFamily);
            }
            if(selfInLineup && found.length == bond.families.length) return true;
         }
         return false;
      }

      public function getPurpleBondDescription() : String
      {
         if(GlobalData.$mConfig_simple.bonds_104) return getBondDescription104()+getEquipmentBondDescription104();
         if(getStar()!=5) return "";
         var definitions:Array = GlobalData.$mConfig_simple.purple_bonds as Array;
         if(!definitions) return "";
         var family:String = GlobalData.baseModHeroId(avatarData.id).split("_").slice(0,2).join("_");
         for each(var bond:Object in definitions)
         {
            if(bond.families.indexOf(family)<0) continue;
            var color:uint = getPurpleBondIsActive() ? 0x00CCFF : 0x888888;
            var concise:String = bond.short_info != null ? String(bond.short_info) : String(bond.name) + "\n" + String(bond.info);
            var lines:Array = concise.split(/\r?\n/);
            var html:String = "<br/>";
            for(var i:int=0;i<lines.length;i++)
            {
               if(i>0) html += "<br/>";
               html += Tools.formatHtmlText(String(lines[i]),color,i==0,i==0 ? 16 : 15,"",0);
            }
            return html;
         }
         return "";
      }

