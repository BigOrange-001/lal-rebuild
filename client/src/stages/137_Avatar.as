            p=u/.28;if(p<=1) demonFxPut105(out,"glow",tx,ty,.5+1.1*demonFxOut105(p),.5+1.1*demonFxOut105(p),0,1-p);
            // Spinning blades.
            p=u/.62;
            if(p<=1)
            {
               s=(.5+.3*demonFxOut105(u/.1));a=1-p*p;
               for(i=0;i<3;i++)
               {
