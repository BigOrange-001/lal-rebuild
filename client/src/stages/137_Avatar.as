            if(age<0 || age>life) continue;
            var p:Number=age/life;
            var px:Number=x+(demonFxRand105(seed,i+600)-.5)*spread+Math.sin(age*7+i)*6;
            var py:Number=y+(demonFxRand105(seed,i+700)-.5)*spread*.35-rise*p;
